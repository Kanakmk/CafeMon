---
import '../styles/global.css'
const base = import.meta.env.BASE_URL
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen grid grid-cols-[minmax(10rem,14rem)_minmax(0,1fr)] md:grid-cols-[minmax(12rem,16rem)_minmax(0,1fr)] lg:grid-cols-[minmax(14rem,20rem)_minmax(0,1fr)] gap-x-4 md:gap-x-6 lg:gap-x-8 bg-[#F5F0E0]">
    
    <!-- Sidebar -->
    <aside class="sidebar-fade min-h-screen bg-linear-to-b from-[#F6ED57] to-transparent flex flex-col items-start px-8 py-10 gap-6 w-87.5 relative" style="font-family: 'Caveat', cursive;">
      
      <div class="w-full mb-4 relative">
        <!-- Leaves -->
        <img 
          src={`${base}/leaves.png`}
          alt="leaves decoration" 
          class="absolute -top-10 -left-8 max-w-none w-115.5 pointer-events-none z-0"
        />
        
        <!-- Logo -->
        <img 
          src={`${base}/logo.png`} 
          alt="my logo" 
          class="relative w-[120%] z-10 mx-auto"
        />
      </div>

      <!-- Navigation -->
      <nav class="flex flex-col mt-30 mx-auto gap-1">
        <a href="/" class="text-[#867A26] text-xl hover:text-white transition-colors duration-200 nav-item-1">
          <img 
            src={`${base}/sprouticon.png`} 
            alt="home icon" 
            class="inline-block w-8 h-8 mr-4"
          />
          <b>h o m e</b>
        </a>
        <a href="/portfolio" class="text-[#D09918] text-xl hover:text-white transition-colors duration-200 nav-item-2">
          <img 
            src={`${base}/sparkleicon.png`} 
            alt="portfolio icon" 
            class="inline-block w-8 h-8 mr-4"
          />  
          <b>p o r t f o l i o</b>
        </a>
        <a href="/projects" class="text-[#B78D4A] text-xl hover:text-white transition-colors duration-200 nav-item-3">
          <img 
            src={`${base}/breadicon.png`} 
            alt="projects icon" 
            class="inline-block w-8 h-8 mr-4"
          />
          <b>p r o j e c t s</b>
        </a>
      </nav>

      <!-- Contact at bottom -->
      <div class="mt-auto mx-auto">
        <a href="/contact" class="text-[#5C4A1E] text-2xl hover:text-white transition-colors duration-200">
          <img 
            src={`${base}/contact.png`} 
            alt="contact icon" 
            class="inline-block w-50 h-50"
          />
        </a>
      </div>

    </aside>

    <!-- Main Content -->
    <main class="min-h-screen p-6 sm:p-8 lg:p-10">
      <div class="flex justify-center">
        <img
          src={`${base}/interactive_placeholder.png`}
          alt="interactive placeholder"
          class="banner-fade w-full max-w-[clamp(45rem,80vw,65rem)] pointer-events-none"
        />
      </div>
      <div class="mt-6">
        <slot />
      </div>
    </main>

  </body>
</html>